{
  "meta": {
    "schema": "1.0",
    "product": "温言",
    "register": "product",
    "platform": "android-compose",
    "axes": { "variance": 5, "motion": 4, "density": 3 },
    "note": "色值以 SPEC v1.0 第 8 节为准锁定；本文件为前端唯一 Token 来源，Compose 端据此生成 Color/Type 常量。禁止在组件中硬编码色值。v1.6.1 配色与启动图标（陶土棕气泡×米白底）对齐：墨绿×宣纸 → 陶土棕×暖米白。v1.6.3 沉浸式手势小白条：系统状态栏/导航栏全透明露出 color.light.bg / color.dark.bg，手势条颜色由 Android 15 系统按背景亮度自动对比（浅底深灰条/深底浅条），无需新 Token。"
  },

  "color": {
    "light": {
      "bg": "#F6F0E6",
      "surface": "#EFE6D8",
      "surfaceElevated": "#FDFAF3",
      "fg": "#2B2118",
      "fgSecondary": "#4B4032",
      "muted": "#6E6050",
      "meta": "#A49785",
      "border": "#E3D8C5",
      "borderSoft": "#EFE6D6",
      "accent": "#A4551C",
      "accentOn": "#FFFFFF",
      "accentHover": "#934A14",
      "accentPressed": "#7F400F",
      "accentSoft": "#F7ECE0",
      "success": "#16A34A",
      "warn": "#D97706",
      "danger": "#DC2626",
      "dangerSoft": "#FBEAE3",
      "warm": "#C0743F",
      "warmSoft": "#F7EADC",
      "warmOn": "#8F4F24",
      "scrim": "rgba(43,33,24,0.45)"
    },
    "dark": {
      "bg": "#17120E",
      "surface": "#211A13",
      "surfaceElevated": "#2B221A",
      "fg": "#F1EAE0",
      "fgSecondary": "#CFC3B1",
      "muted": "#AC9D8A",
      "meta": "#6E6153",
      "border": "#3A3026",
      "borderSoft": "#2E261D",
      "accent": "#CE8A56",
      "accentOn": "#221104",
      "accentHover": "#DB9C6B",
      "accentPressed": "#BE7A45",
      "accentSoft": "#332417",
      "success": "#16A34A",
      "warn": "#D97706",
      "danger": "#DC2626",
      "dangerSoft": "#2A1717",
      "warm": "#DFA678",
      "warmSoft": "#3A2A1C",
      "warmOn": "#F2CBA9",
      "scrim": "rgba(0,0,0,0.60)"
    }
  },

  "typography": {
    "font": {
      "display": "Roboto, Noto Sans SC, sans-serif",
      "body": "Roboto, Noto Sans SC, sans-serif",
      "mono": "Roboto Mono, monospace"
    },
    "typeScale": {
      "display":  { "size": 32, "weight": 500, "lineHeight": 40, "letterSpacing": -0.8, "unit": "sp" },
      "headline": { "size": 24, "weight": 500, "lineHeight": 32, "letterSpacing": 0,    "unit": "sp" },
      "title":    { "size": 20, "weight": 500, "lineHeight": 28, "letterSpacing": 0,    "unit": "sp" },
      "subtitle": { "size": 16, "weight": 500, "lineHeight": 24, "letterSpacing": 0,    "unit": "sp" },
      "body":     { "size": 16, "weight": 400, "lineHeight": 24, "letterSpacing": 0,    "unit": "sp" },
      "bodySm":   { "size": 14, "weight": 400, "lineHeight": 20, "letterSpacing": 0,    "unit": "sp" },
      "label":    { "size": 13, "weight": 500, "lineHeight": 18, "letterSpacing": 0.3,  "unit": "sp" },
      "caption":  { "size": 12, "weight": 400, "lineHeight": 16, "letterSpacing": 0.2,  "unit": "sp" },
      "mono":     { "size": 14, "weight": 400, "lineHeight": 20, "letterSpacing": 0,    "unit": "sp", "font": "mono" }
    },
    "usage": {
      "headline": "页面主标题/分析结论",
      "title": "卡片标题/问卷题面",
      "subtitle": "分节标题/字段名",
      "body": "正文/消息气泡",
      "bodySm": "辅助说明/转述内容",
      "label": "按钮文字/标签/徽标",
      "caption": "时间戳/元信息/引用",
      "mono": "API Key/Base URL/Host"
    }
  },

  "spacing": {
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20,
    "xxl": 24, "xxxl": 32, "xl4": 40, "xl5": 48,
    "unit": "dp"
  },

  "radius": {
    "sm": 8, "md": 12, "lg": 16, "xl": 18, "pill": 9999,
    "unit": "dp"
  },

  "iconSize": {
    "sm": 16, "md": 20, "lg": 24,
    "unit": "dp",
    "library": "Material Symbols (Outlined)",
    "rule": "全项目仅此一套图标库，禁 emoji 字符，禁多库混用"
  },

  "elevation": {
    "flat":   { "light": "none", "dark": "none" },
    "raised": { "light": "0 2px 8px rgba(0,0,0,0.06)", "dark": "0 4px 16px rgba(0,0,0,0.40)" },
    "overlay": "scrim"
  },

  "motion": {
    "fast": 150,
    "base": 200,
    "slow": 300,
    "typingCursor": 900,
    "typingDot": 150,
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "prefers-reduced-motion 下所有动效降为 0ms 或静态"
  },

  "component": {
    "bubbleUser":      { "bg": "accent", "fg": "accentOn", "radius": "lg", "maxWidthPercent": 82, "padding": "md/lg" },
    "bubbleAi":        { "bg": "surfaceElevated", "fg": "fg", "radius": "lg", "maxWidthPercent": 92, "border": "borderSoft", "padding": "lg", "note": "P1 风格：白卡浮在暖米白底上" },
    "inputBar":        { "bg": "surfaceElevated", "radius": "pill", "border": "border", "height": 48, "paddingH": "lg" },
    "primaryButton":   { "bg": "accent", "fg": "accentOn", "radius": "md", "height": 48, "paddingH": "lg", "minTouch": 48 },
    "secondaryButton": { "bg": "transparent", "fg": "accent", "radius": "md", "border": "border", "height": 48, "minTouch": 48 },
    "ghostButton":     { "bg": "transparent", "fg": "muted", "radius": "md", "height": 48, "minTouch": 48 },
    "chip":            { "bg": "surfaceElevated", "fg": "fg", "border": "border", "radius": "pill", "height": 36, "paddingH": "lg", "selectedBg": "accentSoft", "selectedFg": "accent", "selectedBorder": "accent", "minTouch": 36 },
    "card":            { "bg": "surfaceElevated", "fg": "fg", "radius": "lg", "border": "borderSoft", "elevation": "flat", "note": "P1 风格：大圆角白卡" },
    "sheet":           { "bg": "surfaceElevated", "radiusTop": "xl", "elevation": "raised", "dragHandle": true },
    "dialog":          { "bg": "surfaceElevated", "radius": "lg", "scrim": "scrim" },
    "divider":         { "color": "borderSoft", "thickness": 1 },
    "progressTrack":   { "bg": "borderSoft", "indicator": "accent", "height": 4, "radius": "pill" },
    "textField":       { "bg": "surfaceElevated", "border": "border", "focusBorder": "accent", "radius": "sm", "height": 48 },
    "tag":             { "neutral": { "bg": "borderSoft", "fg": "muted" }, "warm": { "bg": "warmSoft", "fg": "warmOn" }, "danger": { "bg": "dangerSoft", "fg": "danger" } },
    "analysisCard":    { "bg": "surfaceElevated", "radius": "lg", "border": "borderSoft", "sectionGap": "xxl", "stepTitleColor": "accent", "note": "v1.6.1 陶土棕系：近白卡+大圆角，段标题陶土棕（如'先分清事实'）" },
    "replyCard":       { "bg": "accentSoft", "radius": "lg", "labelColor": "warmOn", "copyButtonBorder": "accent", "note": "v1.6.1 陶土棕系：浅奶咖话术卡 + 深棕标签 + 描边复制按钮" },
    "quoteBlock":      { "bg": "surface", "border": "borderSoft", "radius": "sm", "padding": "lg" },
    "dividerThick":    { "color": "border", "thickness": 8, "note": "设置页分组间隔" }
  }
}
